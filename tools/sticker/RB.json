 "glsl": [
  "vec3 W = #f2f3f6, Cb = #1b1c20, Y = #f4cf2e, Bm = #1740b8;",
  "vec3 col = W;",
  "float yl = 0.67 + 0.545 * clamp(p.z + 1.26, -0.3, 0.44) + 0.15 * clamp(p.z + 0.82, 0.0, 0.55);",
  "col = mix(col, Cb, aaS(p.y - yl) * (1.0 - aaS(p.z + 0.28)));",
  "col = mix(col, Y, aaS(p.y - 0.86) * band(p.z, -0.28, 0.15));",
  "// Blau wie am echten Auto, als glatte Kurven am Modell: unten entlang, vorn am Seitenkasten hoch, hinten als Keil ueber dem weissen Feld mit dem VISA-Schriftzug",
  "float Lb = 0.232 - 0.053 * clamp((p.z + 0.948) / 0.483, 0.0, 1.0) + 0.106 * clamp((p.z + 0.465) / 0.463, 0.0, 1.0) + 0.105 * clamp((p.z + 0.002) / 0.378, 0.0, 1.0) + 0.189 * clamp((p.z - 0.376) / 0.126, 0.0, 1.0) + 0.063 * clamp((p.z - 0.502) / 0.337, 0.0, 1.0);",
  "float Ub = 0.495 + 0.073 * clamp((-0.549 - p.z) / 0.399, 0.0, 1.0) + 0.106 * clamp((-0.948 - p.z) / 0.368, 0.0, 1.0) + 0.10 * clamp((-1.316 - p.z) / 0.35, 0.0, 1.0);",
  "float yb = 0.20 + 0.07 * clamp((p.z + 1.0) / 0.052, 0.0, 1.0) + 0.151 * clamp((p.z + 0.948) / 0.105, 0.0, 1.0) + 0.074 * clamp((p.z + 0.843) / 0.294, 0.0, 1.0);",
  "float bl = max((1.0 - aaS(p.y - Lb)) * (1.0 - aaS(p.z - 0.9)), (1.0 - aaS(p.y - Ub)) * aaS(p.y - yb) * (1.0 - aaS(p.z + 0.549)));",
  "col = mix(col, Bm, bl * aaS(p.z + 1.62));",
  "col = mix(col, Cb, band(p.z, 0.6, 1.34) * (1.0 - aaS(p.y - 0.345)));",
  "col = mix(col, Cb, aaS(p.y - 0.70) * (1.0 - aaS(p.z + 1.02)));",
  "col = mix(col, Cb, 1.0 - aaS(p.z + 1.92));",
  "col = mix(col, Cb, 1.0 - aaS(p.y - 0.15));",
  "return col;"
 ],
