  "if (p.z > -1.4 && p.z < 0.4 && abs(p.x) > 0.25) col = mix(col, G, (1.0 - aaS(p.y - 0.235)));",
  "if (p.z > -1.4 && p.z < 0.4 && abs(p.x) > 0.25) col = mix(col, K, band(p.y, 0.235, 0.25));",
  "if (p.y > 0.6 && p.z < -0.22 && p.z > -0.62 && abs(p.x) > 0.09 && abs(p.x) < 0.27) col = #e30613;",
  "if (p.z < -1.93) col = (p.y > 0.5 && abs(p.x) > 0.4) ? G : K;",
  "return col;"
