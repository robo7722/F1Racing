  "if (c > 0.5 && c < 1.5) { col = K; if (p.z > 1.9) col = Pk; if (p.z < -1.9) col = Pk; }",
  "if (c > 1.5 && c < 2.5) col = Pk;",
  "if (c > 6.5) col = Pk;",
  "return col;"
