  "float yl = 0.80 + 0.47 * clamp(p.z + 0.95, -0.25, 0.24) + 0.17 * clamp(p.z + 0.71, 0.0, 0.42);",
  "col = mix(col, K, aaS(p.y - yl) * (1.0 - aaS(p.z + 0.28)));",
  "col = mix(col, K, (1.0 - aaS(p.y - 0.25)) * (1.0 - aaS(p.z - 1.5)));",
  "if (p.z < -1.9 && p.y > 0.61) col = Pk;",
