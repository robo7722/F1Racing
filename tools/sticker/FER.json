  "col = mix(col, K, (1.0 - aaS(p.y - 0.545)) * band(p.z, 0.80, 1.75));",
  "col = mix(col, K, (1.0 - aaS(p.y - 0.43)) * band(p.z, 0.55, 0.81));",
  "if (p.z < -1.72 && p.y > 0.2) col = K;",
  "if (p.z > 2.1 && p.y < 0.30) col = K;",
  "if (c > 0.5 && c < 1.5) col = K;",
  "if (c > 1.5 && c < 2.5) col = K;",
  "if (c > 6.5) col = K;",
  "return col;"
